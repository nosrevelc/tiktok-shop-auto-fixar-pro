{
  "manifest_version": 3,
  "name": "TikTok Shop Auto Fixar",
  "version": "3.0.0",
  "description": "Auto renova o botão +60s no TikTok Shop LIVE.",
  "permissions": [
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://shop.tiktok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Auto Fixar"
  }
}